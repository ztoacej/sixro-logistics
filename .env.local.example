# Local development only. Copy to .env.local; never use these passwords in production.
POSTGRES_PASSWORD=sixro-local-admin
APP_DB_PASSWORD=sixro-local-app
POSTGRES_HOST_PORT=5434
REDIS_PASSWORD=sixro-local-redis
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
ZIPKIN_HOST_PORT=9411
# Paths are relative to the repository root. Existing keys are mounted read-only.
LOCAL_KEY_DIRECTORY=./local-keys
# Optional integrations. Leave blank for local startup; supply real values only
# when deliberately testing external API calls. Dummy credentials cannot send.
TMAP_APP_KEY=
SLACK_BOT_TOKEN=
GEMINI_API_KEY=
JVM_MAX_RAM_PERCENTAGE=65
